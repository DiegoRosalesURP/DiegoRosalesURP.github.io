{
  "name": "LAB-02 Perfil",
  "image": "mcr.microsoft.com/devcontainers/base:2.2.1-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Perfil web",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "docker compose build",
  "postStartCommand": "bash .devcontainer/iniciar-servicios.sh",
  "remoteUser": "vscode"
}